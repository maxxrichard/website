# SQLite file (default). For a hosted DB use a libsql/Turso URL, e.g. libsql://my-db.turso.io
DATABASE_URL=file:./data/site.db
# Only needed for remote libsql/Turso databases
DATABASE_AUTH_TOKEN=

# Admin login for /admin  (change these!)
ADMIN_EMAIL=admin@maxxrichard.com
ADMIN_PASSWORD=change-me-now
# Random long string used to sign the admin session cookie
SESSION_SECRET=replace-with-a-long-random-string

# Public URL of the site (used for metadata / sitemap)
SITE_URL=https://www.maxxrichard.com
